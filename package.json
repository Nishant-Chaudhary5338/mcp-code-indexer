{
  "name": "mcp-code-indexer",
  "private": true,
  "type": "module",
  "description": "Index any TypeScript/React repo (incl. monorepos) into a queryable code graph — npx CLI, HTTP/WS server, and MCP server. Published as `code-graph-indexer`.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nishant-Chaudhary5338/mcp-code-indexer.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "index": "node tools/code-indexer/build/code-indexer/src/cli-bin.js index --root",
    "serve": "pnpm --filter indexer-server start",
    "ui": "pnpm --filter code-graph dev",
    "prove": "tsx tools/code-indexer/scripts/prove-any-repo.ts"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "^9.39.4",
    "prettier": "^3.5.0",
    "tsx": "^4.22.4",
    "turbo": "^2.8.20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "sharp"
    ]
  }
}
