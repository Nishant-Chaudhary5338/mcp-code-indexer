{
  "name": "code-graph-indexer",
  "version": "0.2.0",
  "type": "module",
  "mcpName": "io.github.nishant-chaudhary5338/mcp-code-indexer",
  "description": "Index any TypeScript/React repo (incl. monorepos) into a queryable code graph — npx CLI, HTTP/WS server, and MCP server. Reverse queries (who-renders/who-calls/find-references), blast-radius, cycles, dead-code orphans, symbol signatures, external (node_modules) deps, semantic search, and a context-pack for AI agents.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "code-graph",
    "code-intelligence",
    "dependency-graph",
    "react",
    "typescript",
    "ts-morph",
    "claude",
    "ai-tools"
  ],
  "license": "MIT",
  "author": "Nishant Chaudhary <nishantchaudhary.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nishant-Chaudhary5338/mcp-code-indexer.git",
    "directory": "packages/code-indexer-dist"
  },
  "homepage": "https://github.com/Nishant-Chaudhary5338/mcp-code-indexer#readme",
  "bugs": {
    "url": "https://github.com/Nishant-Chaudhary5338/mcp-code-indexer/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "code-graph-indexer": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp.js",
    "./serve": "./dist/serve.js",
    "./core": "./dist/core.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@parcel/watcher": "^2.5.0",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "ts-morph": "^24.0.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@repo/code-graph-core": "workspace:*",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "code-indexer-mcp": "workspace:*",
    "indexer-server": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
